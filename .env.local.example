# Copy this file to `.env.local` and fill in your key.
# Get a key at https://console.anthropic.com/ -> API Keys.
# This value stays server-side (used only in /api routes) and is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8