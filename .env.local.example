# Copy this file to `.env.local` and fill in your key.
# Get a key at https://console.anthropic.com/ -> API Keys.
# This value stays server-side (used only in /api routes) and is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Optional: Publish to Google Drive ---
# When both are set, the app shows "Publish to Drive" buttons that upload the
# generated files and convert them to native Google Docs / Google Slides in the
# output folder. Leave unset to keep only .docx / .pptx downloads.
#
# GOOGLE_SERVICE_ACCOUNT_KEY: paste the FULL contents of the service-account JSON
# key file (the whole {...} object) on one line. Keep it secret.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}
#
# DRIVE_OUTPUT_FOLDER_ID: the ID of a Drive folder shared with the service
# account email as Editor (the part of the folder URL after /folders/).
# DRIVE_OUTPUT_FOLDER_ID=1GOsI46bCCCBkelEB7R26_nzhQj4I-r7U

# --- Sign in with Google (required to use the app) ---
# The whole app is gated: only 2hourlearning.com and alpha.school Google
# accounts can sign in. A signed-in user's own Drive files can then be read via
# a pasted Drive link (no sharing needed).
#
# AUTH_SECRET: a random secret for session encryption. Generate with:
#   npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# OAuth client credentials from the Google Cloud "OAuth client ID" (Web app):
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# In production set this to your deployed origin (Vercel sets it automatically
# via VERCEL_URL, but AUTH_URL is the explicit override):
# AUTH_URL=https://your-app.vercel.app